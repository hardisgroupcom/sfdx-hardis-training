      "height": 1000,
      "settle": 2500,
      "evaluate": [
        "(() => { const main = [...document.querySelectorAll('button')].find((b) => /^(Merge pull request|Squash and merge|Rebase and merge)$/.test(b.innerText.trim())); if (!main) return; main.scrollIntoView({ block: 'center' }); const caret = main.parentElement.parentElement.querySelector(\"button[aria-haspopup='true']\"); if (caret) caret.click(); })()"
