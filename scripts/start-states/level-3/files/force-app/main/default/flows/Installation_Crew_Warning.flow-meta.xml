<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <assignments>
        <name>Log_Fault</name>
        <description>Where both fault paths end. A real project sends this somewhere a person reads: a platform event, an error log object, an email to the admin. The course stops at recording it, because what matters here is that the flow has a fault path at all.</description>
        <label>Log Fault</label>
        <locationX>314</locationX>
        <locationY>611</locationY>
        <assignmentItems>
            <assignToReference>Fault_Message</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Crew_Too_Small</name>
        <description>Is the crew smaller than the panel count needs?</description>
        <label>Crew Too Small</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Crew is big enough</defaultConnectorLabel>
        <rules>
            <name>Too_Few_People</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Crew_Is_Too_Small</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Crew_Warning_Task</targetReference>
            </connector>
            <label>Fewer people than the panels need</label>
        </rules>
    </decisions>
    <description>US-021: warns the planner when the crew assigned to an installation is smaller than the panel count needs. Warns once, which is what Crew Warning Sent is for.</description>
    <environments>Default</environments>
    <formulas>
        <name>Crew_Is_Too_Small</name>
        <description>One crew member fits eight panels, and the warning is only sent once per installation.</description>
        <dataType>Boolean</dataType>
        <expression>AND(
  {!$Record.Crew_Size__c} * 8 &lt; {!$Record.Panels_Required__c},
  NOT({!$Record.Crew_Warning_Sent__c})
)</expression>
    </formulas>
    <interviewLabel>Installation Crew Warning {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Installation Crew Warning</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Crew_Warning_Task</name>
        <description>Tells the owner of the installation that the crew looks too small for the job.</description>
        <label>Create Crew Warning Task</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <connector>
            <targetReference>Mark_Warning_Sent</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Crew may be too small for this installation</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Mark_Warning_Sent</name>
        <description>Records that the warning went out, so the next save does not send it again.</description>
        <label>Mark Warning Sent</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Crew_Warning_Sent__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <faultConnector>
            <targetReference>Log_Fault</targetReference>
        </faultConnector>
        <object>Installation__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Crew_Too_Small</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.Crew_Size__c})),
  NOT(ISBLANK({!$Record.Panels_Required__c}))
)</filterFormula>
        <object>Installation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Fault_Message</name>
        <description>What Salesforce said when the create or the update failed.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
