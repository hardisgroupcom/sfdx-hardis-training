<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <assignments>
        <name>Move_To_Scheduled</name>
        <label>Move To Scheduled</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Scheduled</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Flat_Roof_Crew</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Raise_Crew_For_Flat_Roof</name>
        <label>Raise Crew For Flat Roof</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>$Record.Crew_Size__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Crew_Over_Cap</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Bring_Crew_Back_To_Cap</name>
        <label>Bring Crew Back To Cap</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>$Record.Crew_Size__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Crew_Capacity_Cap__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Flat_Roof_Crew</name>
        <label>Flat Roof Crew</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Crew_Over_Cap</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nothing to raise</defaultConnectorLabel>
        <rules>
            <name>Flat_Roof_Under_Three</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Roof_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Flat</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Crew_Size__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Raise_Crew_For_Flat_Roof</targetReference>
            </connector>
            <label>Flat roof with fewer than three</label>
        </rules>
    </decisions>
    <decisions>
        <name>Crew_Over_Cap</name>
        <label>Crew Over Cap</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Within the cap</defaultConnectorLabel>
        <rules>
            <name>Too_Large</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Crew_Capacity_Cap__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Crew_Size__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Record.Crew_Capacity_Cap__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bring_Crew_Back_To_Cap</targetReference>
            </connector>
            <label>Too large for this installation</label>
        </rules>
    </decisions>
    <description>When a planner puts a crew on a planned installation that already has a date, the installation moves to Scheduled on its own. A flat roof gets a crew of at least three (US-034), and then a crew larger than the installation cap is brought back down to it (US-018). The cap runs last, so it always wins: too many people on a small roof is a safety problem.</description>
    <environments>Default</environments>
    <interviewLabel>Installation Assign Crew {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Installation Assign Crew</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Move_To_Scheduled</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.Crew_Size__c})),
  NOT(ISBLANK({!$Record.Install_Date__c})),
  ISPICKVAL({!$Record.Status__c}, "Planned")
)</filterFormula>
        <object>Installation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
